# ==============================================================================
# ShapeFit - Configuração de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.development, .env.staging ou .env.production
# ==============================================================================

# Ambiente de Execução (Development | Staging | Production)
ENVIRONMENT=Development

# Configurações do Banco de Dados PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=shapefit_dev
POSTGRES_USER=shapefit_user
POSTGRES_PASSWORD=shapefit_password

# Configurações do Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Porta da API .NET
API_HTTP_PORT=5000
API_HTTPS_PORT=7239

# Flutter Mobile / Web API Target
FLUTTER_API_BASE_URL=http://localhost:5000
